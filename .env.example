# Wedding Website Config
# copy this file to .env and fill in your details.

# dates (ISO format YYYY-MM-DD)
# both cutoff dates are inclusive
# VITE_RSVP_CUTOFF_DATE is the deadline shown to guests
# RSVP_CUTOFF_DATE is when the backend actually locks RSVPs. Can set to later to do a grace period situation
VITE_WEDDING_DATE=2025-10-15
VITE_RSVP_CUTOFF_DATE=2025-08-15
RSVP_CUTOFF_DATE=2025-08-16

# couple 
# use the same short name and first name if you dont want to use a nickname
VITE_PERSON1_FIRST_NAME=Alexander
VITE_PERSON1_SHORT_NAME=Alex
VITE_PERSON1_PHONE=555-123-4567
VITE_PERSON2_FIRST_NAME=Jordan
VITE_PERSON2_SHORT_NAME=Jordan
VITE_PERSON2_PHONE=555-987-6543

# arrival time to be displayed on home page
VITE_ARRIVAL_TIME=5:45 - 6:00 PM

#venue
VITE_VENUE_NAME=The Venue at Venue Park
VITE_VENUE_CITY=Tampa, FL
VITE_VENUE_ADDRESS=123 Main St, Tampa, FL 12345


# Admin authentication
# 
# seed only runs when admin_users is empty
# for production, use a secrets manager or your platform's encrypted env instead of a .env file.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

TRUSTED_ORIGINS=http://localhost:5173,http://localhost:3001
# NODE_ENV=production enables: trust proxy, Secure cookie flag.
